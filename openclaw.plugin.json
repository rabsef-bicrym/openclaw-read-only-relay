{
  "id": "read-only-relay",
  "uiHints": {
    "enabled": {
      "label": "Enabled",
      "help": "Enable read-only channel relay enforcement."
    },
    "skipRelayToken": {
      "label": "Skip Relay Token",
      "help": "Exact text that suppresses relay when used as the only reply content."
    },
    "rules": {
      "label": "Read-only Rules",
      "help": "Channel endpoints that can send inbound messages but cannot receive direct replies."
    },
    "blockedChannels": {
      "label": "Blocked Channels",
      "help": "Optional channel-wide shorthand for messengers that should be read-only."
    },
    "relay": {
      "label": "Shared Relay",
      "help": "Relay destination used by blockedChannels shorthand rules."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "skipRelayToken": {
        "type": "string",
        "minLength": 1
      },
      "blockedChannels": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "relay": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "to"],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "threadId": {
            "type": ["string", "number"]
          }
        }
      },
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "relay"],
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "conversationId": {
              "type": "string",
              "minLength": 1
            },
            "accountId": {
              "type": "string",
              "minLength": 1
            },
            "relay": {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel", "to"],
              "properties": {
                "channel": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "accountId": {
                  "type": "string",
                  "minLength": 1
                },
                "threadId": {
                  "type": ["string", "number"]
                }
              }
            }
          }
        }
      }
    }
  }
}
